{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:/workspace/allowed"
      ],
      "env": {}
    },
    "web-reader": {
      "type": "http",
      "url": "https://mcp.example.com/mcp",
      "headers": {
        "Authorization": "Bearer ${WEB_READER_TOKEN}"
      },
      "timeoutSeconds": 30
    }
  }
}
