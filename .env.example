# =============================================================
# WARNING: This is a TEMPLATE. Copy to .env and fill in values.
# NEVER commit real API keys or secrets to version control.
# =============================================================

# API Authentication (P0 - Security)
# Comma-separated list of accepted X-API-Key values; unset = auth disabled (dev only)
API_KEYS=your-secret-api-key-here

# LLM Configuration
OPENAI_API_KEY=sk-your-openai-compatible-key-here
OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_MODEL=your-model-name

# Security (required in production — compose fails fast if unset)
JWT_SECRET=generate-a-random-secret-at-least-32-characters-long

# Redis (optional caching)
REDIS_URL=redis://localhost:6379/0

# Optional: Multiple API keys (comma-separated)
# API_KEYS=key1,key2,key3

# Retrieval configuration (kept separate from the chat model)
# Use an OpenAI-compatible embeddings endpoint. For SiliconFlow, use the
# matching embedding/reranking models below and supply the provider keys.
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=your-embedding-api-key-here
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIMENSIONS=1024
EMBEDDING_ALLOW_TRUNCATION=1
EMBEDDING_TIMEOUT_SECONDS=30

# Optional cross-encoder reranking for long-term-memory retrieval.
RAG_RERANKER=remote
RERANKER_BASE_URL=https://api.siliconflow.cn/v1
RERANKER_API_KEY=your-reranker-api-key-here
RERANKER_MODEL=Qwen/Qwen3-Reranker-8B
RERANKER_TIMEOUT_SECONDS=60
RERANKER_MAX_CANDIDATES=20
RAG_MIN_RERANK_SCORE=0.05
# Per-tool execution timeout. Timed-out synchronous handlers may finish in the background.
TOOL_TIMEOUT_SECONDS=20

# JSON contract generation attempts (first pass plus one corrective retry by default).
STRUCTURED_OUTPUT_MAX_ATTEMPTS=2

# External MCP servers (optional). Point to an explicit JSON file in the
# standard {"mcpServers": {...}} format. This supports stdio and HTTP.
# Example: MCP_CONFIG_PATH=C:/Users/Administrator/.astrcode/mcp.json
# MCP_CONFIG_PATH=~/.simpleagent/mcp.json
